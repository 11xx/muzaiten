{
  "_doc": "Punctuation and symbols folded onto the ASCII character a searcher types, applied after NFKC. Tag editors and file-name sanitizers substitute look-alikes (∶ for :, ⁄ for /, ’ for ') that would otherwise never match a typed query. Characters that separate words without an ASCII counterpart fold to a space.",
  "map": {
    "‘": "'", "’": "'", "‚": "'", "‛": "'", "′": "'", "‵": "'", "´": "'",
    "ʹ": "'", "ʻ": "'", "ʼ": "'", "ʽ": "'", "ˈ": "'", "ꞌ": "'", "Ꞌ": "'",
    "‹": "'", "›": "'",
    "“": "\"", "”": "\"", "„": "\"", "‟": "\"", "″": "\"", "‶": "\"", "〃": "\"", "ˮ": "\"",
    "«": "\"", "»": "\"", "「": "\"", "」": "\"", "『": "\"", "』": "\"", "〝": "\"", "〞": "\"", "〟": "\"",
    "‐": "-", "‑": "-", "‒": "-", "–": "-", "—": "-", "―": "-", "−": "-", "⁃": "-", "⸺": "-", "⸻": "-", "〜": "~", "〰": "~", "∼": "~", "⁓": "~",
    "∶": ":", "꞉": ":", "˸": ":",
    "⁄": "/", "∕": "/", "⧸": "/",
    "∣": "|", "│": "|", "￨": "|",
    "。": ".", "、": ",", "٫": ".", "٬": ",",
    "【": "[", "】": "]", "〔": "[", "〕": "]", "〖": "[", "〗": "]", "〘": "[", "〙": "]", "〚": "[", "〛": "]",
    "《": "<", "》": ">", "〈": "<", "〉": ">", "⟨": "<", "⟩": ">",
    "×": "x", "✕": "x", "✖": "x", "⨯": "x",
    "・": " ", "·": " ", "•": " ", "‧": " ", "∙": " ", "⋅": " ",
    "¡": "!", "¿": "?", "।": " ", "॥": " ", "།": " ", "༎": " ",
    "˂": "<", "˃": ">",
    "˖": "+", "˗": "-"
  }
}
